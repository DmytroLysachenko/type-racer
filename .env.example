# Required for live multiplayer. Typing remains available locally without Pusher.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Optional dedicated guest-cookie signing key (32+ random bytes recommended).
# If omitted, the server uses PUSHER_SECRET with a distinct signing context.
SESSION_SECRET=
# Optional stable production origin for canonical URLs, robots, sitemap, and share previews.
# Example: https://typearena.example
SITE_URL=
